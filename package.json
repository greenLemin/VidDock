{
  "name": "viddock",
  "version": "1.0.0",
  "private": true,
  "description": "VidDock - free, privacy-first Chrome video downloader (HLS, DASH, direct media).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/build-extension.mjs --watch",
    "build": "npm run build:host && npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "build:host": "node scripts/build-host.mjs",
    "host:install": "bash scripts/install-macos.sh",
    "host:uninstall": "bash scripts/uninstall-macos.sh",
    "icons": "node scripts/generate-icons.mjs",
    "pretest": "npm run build",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "bash scripts/build-release.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.290",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "vite": "^6.4.5",
    "esbuild": "^0.25.0"
  }
}
